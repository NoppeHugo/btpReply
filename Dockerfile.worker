FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm exec prisma generate
# tsx (registre complet, transpile en CJS) et non tsx/esm : le chargeur ESM pur
# déclenche ERR_REQUIRE_CYCLE_MODULE sur Node ≥ 22.12 (require(esm) en cycle),
# alors qu'aucun cycle source n'existe. Le registre complet évite ce chemin.
CMD ["node", "--import", "tsx", "worker/index.ts"]
