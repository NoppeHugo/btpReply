generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  owner
}

enum ClientStage {
  prospect
  active
  paused
}

enum ConversationState {
  open
  qualified
  handed_off
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum LeadUrgency {
  low
  medium
  high
}

enum LeadStatus {
  new
  to_callback
  done
}

enum MessageChannel {
  sms
  email
  in_app
}

enum InboundJobStatus {
  pending
  processing
  done
  failed
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// ---------------------------------------------------------------------------
// Client (tenant)
// ---------------------------------------------------------------------------

model Client {
  id               String      @id @default(cuid())
  name             String
  displayName      String?
  stage            ClientStage @default(prospect)
  timezone         String      @default("Europe/Brussels")
  stripeCustomerId String?
  plan             String      @default("base")
  // Paramètres configurables par l'artisan
  initialSmsDelaySec Int       @default(30)
  alertEmail         String?
  alertPhone         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  users            User[]
  phoneNumbers     PhoneNumber[]
  calls            Call[]
  conversations    Conversation[]
  leads            Lead[]
  whitelistEntries WhitelistEntry[]
  businessHours    BusinessHours[]
  messageTemplates MessageTemplate[]
  clientNotes      ClientNote[]
  clientMessages   ClientMessage[]

  @@map("clients")
}

// ---------------------------------------------------------------------------
// User (dashboard access)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  clientId     String
  email        String   @unique
  role         UserRole
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client         Client          @relation(fields: [clientId], references: [id])
  clientNotes    ClientNote[]
  clientMessages ClientMessage[]

  @@index([clientId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// PhoneNumber (Twilio number bound to a client — webhook routing key)
// ---------------------------------------------------------------------------

model PhoneNumber {
  id        String   @id @default(cuid())
  clientId  String
  number    String   @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  calls  Call[]

  @@index([clientId])
  @@map("phone_numbers")
}

// ---------------------------------------------------------------------------
// Call (every missed call captured)
// ---------------------------------------------------------------------------

model Call {
  id            String   @id @default(cuid())
  clientId      String
  phoneNumberId String
  callerNumber  String
  calledAt      DateTime
  twilioCallSid String   @unique
  createdAt     DateTime @default(now())

  client       Client        @relation(fields: [clientId], references: [id])
  phoneNumber  PhoneNumber   @relation(fields: [phoneNumberId], references: [id])
  conversation Conversation?

  @@index([clientId])
  @@index([callerNumber])
  @@map("calls")
}

// ---------------------------------------------------------------------------
// Conversation (SMS thread linked to a call / caller)
// ---------------------------------------------------------------------------

model Conversation {
  id           String            @id @default(cuid())
  clientId     String
  callId       String            @unique
  callerNumber String
  // Numéro expéditeur Twilio assigné à ce fil (pool de numéros « collants »).
  // Sert de clé de routage des SMS entrants : (senderNumber = receiver, callerNumber).
  senderNumber String?
  state        ConversationState @default(open)
  turnCount    Int               @default(0)
  language     String            @default("fr")
  // false = l'artisan a repris la main : la qualification auto est en pause
  autopilot    Boolean           @default(true)
  // Dernier message échangé : fenêtre de cooldown pour libérer le senderNumber.
  lastMessageAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  call     Call      @relation(fields: [callId], references: [id])
  messages Message[]
  lead     Lead?

  @@index([clientId])
  @@index([callerNumber])
  @@index([callerNumber, senderNumber])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// SenderNumber (pool de numéros expéditeurs Twilio partagés)
// ---------------------------------------------------------------------------
// Le routage des SMS entrants se fait par (senderNumber = receiver, appelant).
// Un numéro est réservé à un appelant tant qu'une conversation reste active dans
// la fenêtre de cooldown, ce qui élimine les collisions de routage. Table
// optionnelle : si vide, le pool est lu depuis l'env (TWILIO_SENDERS / TWILIO_SENDER).

model SenderNumber {
  id        String   @id @default(cuid())
  number    String   @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("sender_numbers")
}

// ---------------------------------------------------------------------------
// InboundSmsJob (file d'attente des SMS entrants à qualifier)
// ---------------------------------------------------------------------------
// Le webhook Twilio acquitte immédiatement (HTTP 200) et met le SMS en file ;
// le worker draine la file et exécute le pipeline de qualification LLM hors du
// chemin de la requête HTTP. Découple la latence LLM du webhook (évite les
// timeouts → retries) et rend le traitement rejouable. `providerMessageId` est
// unique : les retries webhook de Twilio ne créent pas de doublon de job.

model InboundSmsJob {
  id                String           @id @default(cuid())
  providerMessageId String?          @unique
  callerNumber      String
  receiver          String? // notre numéro Twilio destinataire (routage)
  body              String
  status            InboundJobStatus @default(pending)
  attempts          Int              @default(0)
  lastError         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, createdAt])
  @@map("inbound_sms_jobs")
}

// ---------------------------------------------------------------------------
// Message (each inbound / outbound SMS)
// ---------------------------------------------------------------------------

model Message {
  id                String           @id @default(cuid())
  clientId          String
  conversationId    String
  direction         MessageDirection
  body              String
  // Identifiant du message chez le fournisseur SMS (Twilio MessageSid). Référentiel.
  providerMessageId String?          @unique
  sentAt            DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([clientId])
  @@index([conversationId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Lead (qualified result from a conversation)
// ---------------------------------------------------------------------------

model Lead {
  id             String      @id @default(cuid())
  clientId       String
  conversationId String      @unique
  type           String?
  urgency        LeadUrgency?
  location       String?
  availability   String?
  summary        String
  status         LeadStatus  @default(new)
  // true = lead partiel généré par le balayage des conversations abandonnées
  // (le client a commencé à répondre puis n'a pas terminé). Exclu du compteur
  // « leads qualifiés » du récap, mais signalé pour rappel.
  partial        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  client       Client       @relation(fields: [clientId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([clientId])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// WhitelistEntry (numbers excluded from auto-SMS)
// ---------------------------------------------------------------------------

model WhitelistEntry {
  id        String   @id @default(cuid())
  clientId  String
  number    String
  label     String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, number])
  @@index([clientId])
  @@map("whitelist_entries")
}

// ---------------------------------------------------------------------------
// BusinessHours (per-client schedule for message variants)
// ---------------------------------------------------------------------------

model BusinessHours {
  id        String    @id @default(cuid())
  clientId  String
  dayOfWeek DayOfWeek
  openTime  String
  closeTime String
  closed    Boolean   @default(false)

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, dayOfWeek])
  @@index([clientId])
  @@map("business_hours")
}

// ---------------------------------------------------------------------------
// MessageTemplate (custom message templates per client)
// ---------------------------------------------------------------------------

model MessageTemplate {
  id        String   @id @default(cuid())
  clientId  String
  key       String
  body      String
  language  String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, key, language])
  @@index([clientId])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// ClientNote (internal notes from founders about a client/PME)
// ---------------------------------------------------------------------------

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([clientId])
  @@map("client_notes")
}

// ---------------------------------------------------------------------------
// ClientMessage (outbound messages from founders to a client/artisan)
// ---------------------------------------------------------------------------

model ClientMessage {
  id        String         @id @default(cuid())
  clientId  String
  authorId  String
  channel   MessageChannel
  body      String
  status    String         @default("sent")
  sentAt    DateTime       @default(now())

  client Client @relation(fields: [clientId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([clientId])
  @@map("client_messages")
}
