# Base de données (Postgres self-hosted)
DATABASE_URL="postgresql://btpreply:btpreply_dev_password@localhost:5432/btpreply_dev"

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QUALIFICATION=claude-haiku-4-5

# SMS — smstools (smsgatewayapi.com)
# Clés API dans le dashboard smstools. SMSTOOLS_SENDER = numéro virtuel partagé
# (ex. +324...) depuis lequel partent tous les SMS et sur lequel arrivent les
# réponses. SMSTOOLS_WEBHOOK_SECRET protège le webhook entrant : configurer la
# callback URL smstools sur .../api/v1/webhooks/smstools/inbound?token=<secret>
SMSTOOLS_CLIENT_ID=
SMSTOOLS_CLIENT_SECRET=
SMSTOOLS_SENDER=
SMSTOOLS_WEBHOOK_SECRET=

# Pool de numéros « collants » (voir docs/sms-sender-pool.md) — OPTIONNEL.
# Plusieurs numéros séparés par des virgules ; évite les collisions de routage
# quand un même appelant écrit à deux artisans dans la même fenêtre. Si vide, le
# pool = SMSTOOLS_SENDER (numéro unique). Alternative : table SenderNumber en DB.
SMSTOOLS_SENDERS=
# Durée (jours) pendant laquelle un numéro reste réservé à un appelant après le
# dernier message. Passé ce délai, le numéro est réutilisable. Défaut : 7.
SENDER_COOLDOWN_DAYS=7

# Twilio — VOIX uniquement (détection d'appel manqué). SMS = smstools ci-dessus.
# ACCOUNT_SID / AUTH_TOKEN optionnels (non utilisés en REST) ; la signature du
# webhook voice utilise WEBHOOK_SIGNING_KEY.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNING_KEY=

# Email (SMTP — ex. Gmail)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton@gmail.com,
# SMTP_PASS = "mot de passe d'application" Google (pas le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Rappl <ton@gmail.com>"

# App
APP_BASE_URL=http://localhost:3000
API_SECRET_KEY=change-me-before-prod
INITIAL_SMS_DELAY_MS=30000

# Auth.js (next-auth@beta) — generate with: openssl rand -base64 32
AUTH_SECRET=
SEED_ADMIN_PASSWORD=changeme

# Stripe (facturation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PLUS=

# Observabilité
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
