# Base de données (Postgres self-hosted)
DATABASE_URL="postgresql://btpreply:btpreply_dev_password@localhost:5432/btpreply_dev"

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QUALIFICATION=claude-haiku-4-5

# SMS + VOIX — Twilio (voir docs/sms-provider-decision.md)
# ACCOUNT_SID / AUTH_TOKEN : identifiants API Twilio (dashboard → Account Info),
# utilisés pour l'envoi SMS (REST messages.create) ET la voix.
# TWILIO_SENDER = numéro Twilio partagé (E.164, ex. +324...) depuis lequel partent
# les SMS et sur lequel arrivent les réponses.
# TWILIO_WEBHOOK_SIGNING_KEY : clé de signature des webhooks (voix + SMS entrant).
# Webhooks à configurer sur chaque numéro Twilio :
#   Voix : .../api/v1/webhooks/twilio/voice
#   SMS  : .../api/v1/webhooks/twilio/sms  (« A message comes in », POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER=
TWILIO_WEBHOOK_SIGNING_KEY=

# Pool de numéros « collants » (voir docs/sms-sender-pool.md) — OPTIONNEL.
# Plusieurs numéros Twilio séparés par des virgules ; évite les collisions de
# routage quand un même appelant écrit à deux artisans dans la même fenêtre. Si
# vide, le pool = TWILIO_SENDER (numéro unique). Alternative : table SenderNumber.
TWILIO_SENDERS=
# Durée (jours) pendant laquelle un numéro reste réservé à un appelant après le
# dernier message. Passé ce délai, le numéro est réutilisable. Défaut : 7.
SENDER_COOLDOWN_DAYS=7

# Email (SMTP — ex. Gmail)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton@gmail.com,
# SMTP_PASS = "mot de passe d'application" Google (pas le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Rappl <ton@gmail.com>"

# App
APP_BASE_URL=http://localhost:3000
API_SECRET_KEY=change-me-before-prod
INITIAL_SMS_DELAY_MS=30000

# Auth.js (next-auth@beta) — generate with: openssl rand -base64 32
AUTH_SECRET=
SEED_ADMIN_PASSWORD=changeme

# Stripe (facturation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PLUS=

# Observabilité
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
