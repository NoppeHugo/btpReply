# Base de données (Postgres self-hosted)
DATABASE_URL="postgresql://btpreply:btpreply_dev_password@localhost:5432/btpreply_dev"

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QUALIFICATION=claude-haiku-4-5

# SMS + VOIX — Twilio (voir docs/sms-provider-decision.md)
# ACCOUNT_SID / AUTH_TOKEN : identifiants API Twilio (dashboard → Account Info),
# utilisés pour l'envoi SMS (REST messages.create) ET la voix.
# TWILIO_WEBHOOK_SIGNING_KEY : clé de signature des webhooks (voix + SMS entrant) —
# c'est l'Auth Token Twilio.
# Chaque SMS part du numéro Twilio DU CLIENT (celui qui a reçu l'appel) : pas de
# numéro expéditeur global à configurer. Les numéros clients sont en base
# (table phone_numbers). Webhooks à configurer sur chaque numéro Twilio :
#   Voix : .../api/v1/webhooks/twilio/voice
#   SMS  : .../api/v1/webhooks/twilio/sms  (« A message comes in », POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNING_KEY=

# Email (SMTP — ex. Gmail)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton@gmail.com,
# SMTP_PASS = "mot de passe d'application" Google (pas le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Rappl <ton@gmail.com>"

# Onboarding — lien iCloud du Raccourci Apple d'import de contacts (optionnel).
# Artefact one-time créé dans l'app Raccourcis puis partagé via iCloud.
NEXT_PUBLIC_IOS_SHORTCUT_URL=

# App
APP_BASE_URL=http://localhost:3000
API_SECRET_KEY=change-me-before-prod
INITIAL_SMS_DELAY_MS=30000

# Auth.js (next-auth@beta) — generate with: openssl rand -base64 32
AUTH_SECRET=
SEED_ADMIN_PASSWORD=changeme

# Stripe (facturation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PLUS=

# Observabilité
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Web Push (notifications PWA des nouveaux leads) — optionnel.
# Générer les clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@rappl.be
