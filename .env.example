# Base de données (Postgres self-hosted)
DATABASE_URL="postgresql://btpreply:btpreply_dev_password@localhost:5432/btpreply_dev"

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_QUALIFICATION=claude-haiku-4-5

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNING_KEY=

# Email (SMTP — ex. Gmail)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton@gmail.com,
# SMTP_PASS = "mot de passe d'application" Google (pas le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Rappl <ton@gmail.com>"

# App
APP_BASE_URL=http://localhost:3000
API_SECRET_KEY=change-me-before-prod
INITIAL_SMS_DELAY_MS=30000

# Auth.js (next-auth@beta) — generate with: openssl rand -base64 32
AUTH_SECRET=
SEED_ADMIN_PASSWORD=changeme

# Stripe (facturation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PLUS=

# Observabilité
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
